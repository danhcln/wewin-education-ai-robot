# ==============================================================================
# WeWIN Education AI Robot Platform - Unified Environment Configuration Template
# Copy this file to .env before starting the platform services.
# NEVER commit .env or any production secrets to Git version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & SERVICE HOSTING
# ------------------------------------------------------------------------------
WEWIN_BIND_ADDRESS=127.0.0.1
WEWIN_CENTRE_PORT=8000
WEWIN_PORTAL_PORT=8001
WEWIN_AI_PORT=8010
WEWIN_DEVICE_EDGE_PORT=8013

# ------------------------------------------------------------------------------
# 2. WEWIN EDUCATION PORTAL (Backend & Database)
# ------------------------------------------------------------------------------
# SQLite database path for portal data (defaults to portal/data/education.sqlite3)
WEWIN_EDUCATION_DB=portal/data/education.sqlite3

# OCR Settings for homework and document scanning
WEWIN_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
WEWIN_OCR_LANGUAGE=eng+vie

# Upstream LLM / Cloud AI integration (optional, portal functions offline without it)
WEWIN_AI_BASE_URL=
WEWIN_AI_MODEL=
WEWIN_AI_API_KEY=

# ------------------------------------------------------------------------------
# 3. WEWIN CENTRE / CONNECTOR (Knowledge Base, Media, Device Management)
# ------------------------------------------------------------------------------
# Knowledge database and seed paths
DATABASE_PATH=connector/data/wewin_fts.db
KNOWLEDGE_JSON_PATH=connector/data/wewin_knowledge.json
BROWSER_SESSION_STORE=connector/.secrets/browser-sessions.sqlite3

# Admin synchronization token (generate using Python or scripts/rotate_admin_token.py)
ADMIN_SYNC_TOKEN=
ADMIN_SYNC_TOKEN_FILE=connector/.secrets/admin_sync_token

# XiaoZhi MCP Bridge (Optional - for cloud robot bridge connection)
XIAOZHI_MCP_ENDPOINT=
XIAOZHI_MCP_TOKEN=

# Media loopback backend URL
MEDIA_BACKEND_URL=http://127.0.0.1:8000
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 4. WEWIN AI SERVER (Edge Intelligence, TTS, ASR, Tokenizers)
# ------------------------------------------------------------------------------
WEWIN_AI_PUBLIC_WS=ws://127.0.0.1:8010/xiaozhi/v1/
WEWIN_AI_DEVICE_ORIGIN=http://127.0.0.1:8010
WEWIN_AI_TOKENIZER=portal/data/ai-qwen3-tokenizer/tokenizer.json
WEWIN_AI_QWEN25_TOKENIZER=portal/data/ai-qwen25-tokenizer/tokenizer.json
WEWIN_AI_PROVIDER_TIMEOUT=90
WEWIN_AI_LLM_STREAM=1
WEWIN_AI_LLM_GPU_LAYERS=-1
