# No secrets. Do not copy the Windows .env into /opt/wewin/current.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=false
DATABASE_PATH=/var/lib/wewin/wewin_fts.db
KNOWLEDGE_JSON_PATH=/var/lib/wewin/public_knowledge.json
BRIDGE_STATUS_PATH=/var/lib/wewin/bridge-status.json
ADMIN_SYNC_TOKEN_FILE=/etc/wewin/admin_token
ADMIN_SYNC_TOKEN=
XIAOZHI_MCP_ENDPOINT_FILE=/etc/wewin/xiaozhi_endpoint
XIAOZHI_MCP_TOKEN_FILE=/etc/wewin/xiaozhi_token
XIAOZHI_MCP_ENDPOINT=
XIAOZHI_MCP_TOKEN=
CORS_ALLOWED_ORIGINS=
AUTO_SYNC_ENABLED=false
SYNC_SCHEDULE_ARMED=false
SYNC_SCHEDULER_OWNER=external
CRAWLER_DELAY_SECONDS=2.05
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_RETRY_BACKOFF_SECONDS=2
CRAWLER_MAX_RETRY_WAIT_SECONDS=60
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_RESPONSE_BYTES=5242880
PYTHONUNBUFFERED=1
