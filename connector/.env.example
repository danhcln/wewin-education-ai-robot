# ============================================================
# WeWIN AI Website Connector Configuration
# ============================================================

# Server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=false

# Security & Admin Sync Token
ADMIN_SYNC_TOKEN=

# Database & Storage
DATABASE_PATH=data/wewin_fts.db
KNOWLEDGE_JSON_PATH=data/wewin_knowledge.json

# Crawler Settings
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) WeWIN-AI-Connector/1.0
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_DELAY_SECONDS=0.8
MAX_PAGES_TO_CRAWL=50

# XiaoZhi MCP Bridge Settings
# Provided by XiaoZhi Dashboard (xiaozhi.me or your self-hosted server)
XIAOZHI_MCP_ENDPOINT=
XIAOZHI_MCP_TOKEN=

# Auto-Sync Settings (Phase 4)
AUTO_SYNC_ENABLED=false
SYNC_INTERVAL_HOURS=12
SYNC_LOCK_TIMEOUT_MINUTES=25


# Preferred: generate a private file with scripts/rotate_admin_token.py.
# Use exactly one source: token file OR a strong service environment token.
ADMIN_SYNC_TOKEN_FILE=.secrets/admin_sync_token
# Same-origin only by default; optional comma-separated trusted origins.
CORS_ALLOWED_ORIGINS=

SYNC_SCHEDULER_OWNER=windows

SYNC_SCHEDULE_ARMED=false

CRAWLER_RETRY_ATTEMPTS=3

CRAWLER_RETRY_BACKOFF_SECONDS=1

CRAWLER_MAX_RETRY_WAIT_SECONDS=60

CRAWLER_MAX_RESPONSE_BYTES=5242880
# YouTube API key stays on backend; prefer private file, never VITE_* or frontend.
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_FILE=
# Optional metadata-only verified channel record; default .maintenance/media/youtube_channel.json
YOUTUBE_CHANNEL_FILE=
# Bridge-to-API relay; HTTP loopback only. Must match FastAPI port.
MEDIA_BACKEND_URL=http://127.0.0.1:8000
